{
  "name": "barbearia-exemplo-geral",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "demo:reset": "prisma migrate reset --force --skip-seed && node --env-file=.env --import tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "setup": "node scripts/setup-local.mjs && prisma generate && prisma migrate deploy && node --env-file=.env --import tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@prisma/client": "6.19.0",
    "bcryptjs": "latest",
    "zod": "latest",
    "lucide-react": "latest",
    "sharp": "latest",
    "otpauth": "latest",
    "nodemailer": "latest"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "typescript": "^6.0.0",
    "tsx": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/nodemailer": "latest",
    "@playwright/test": "latest",
    "eslint": "^10.13.0",
    "prettier": "latest",
    "lighthouse": "latest",
    "@eslint/js": "latest",
    "typescript-eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
